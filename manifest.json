{
  "manifest_version": 3,
  "name": "直播小助手",
  "version": "1.3.4",
  "version_name": "1.3.4 · EricWang 派生版",
  "description": "EricWang 维护的直播小助手派生版，整合多个直播平台的关注列表。基于 Licardo 的开源项目。",
  "homepage_url": "https://github.com/Feeengyuuu/Live-Assistant",
  "author": "EricWang",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*.douyu.com/*",
    "*://*.huya.com/*",
    "*://*.bilibili.com/*",
    "*://*.douyin.com/*",
    "*://*.twitch.tv/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    },
    "default_popup": "/src/popup.html",
    "default_title": "直播小助手"
  },
  "background": {
    "service_worker": "/src/background.js"
  }
}
